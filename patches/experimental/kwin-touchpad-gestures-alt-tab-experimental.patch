+void TabBox::touchpadWalkThroughWindows(bool forward)
+{
+    if (!options->focusPolicyIsReasonable()) {
+        CDEWalkThroughWindows(forward);
+        return;
+    }
+
+    if (isDisplayed()) {
+        KDEWalkThroughWindows(forward);
+    } else {
+        if (!establishTabBoxGrab()) {
+            return;
+        }
+        m_tabGrab = true;
+        m_noModifierGrab = true;
+
+        input()->keyboard()->update();
+        input()->pointer()->setEnableConstraints(false);
+
+        setMode(TabBoxWindowsMode);
+        reset();
+
+        if (haveActiveClient()) {
+            nextPrev(forward);
+        }
+
+        show();
+    }
+
+    m_touchpadAcceptTimer.start(1100);
+}
