+/*
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+
+import QtQuick
+import QtQuick.Layouts
+import QtQuick.Controls as QQC2
+import org.kde.kirigami as Kirigami
+import org.kde.kcmutils as KCM
+
+KCM.SimpleKCM {
+    id: root
+
+    implicitWidth: Kirigami.Units.gridUnit * 52
+    implicitHeight: Kirigami.Units.gridUnit * 36
+
+    readonly property var noAction: [{ text: i18nc("@item:inlistbox Touchpad gesture action", "Disabled"), value: "Disabled" }]
+    readonly property var overviewActions: noAction.concat([{ text: i18nc("@item:inlistbox Touchpad gesture action", "Overview"), value: "Overview" }])
+    readonly property var minimizeActions: noAction.concat([{ text: i18nc("@item:inlistbox Touchpad gesture action", "Minimize All Windows"), value: "MinimizeAll" }])
+    readonly property var horizontalActions: noAction.concat([
+        { text: i18nc("@item:inlistbox Touchpad gesture action", "Previous Window"), value: "SwitchWindowPrevious" },
+        { text: i18nc("@item:inlistbox Touchpad gesture action", "Next Window"), value: "SwitchWindowNext" },
+        { text: i18nc("@item:inlistbox Touchpad gesture action", "Previous Virtual Desktop"), value: "PreviousVirtualDesktop" },
+        { text: i18nc("@item:inlistbox Touchpad gesture action", "Next Virtual Desktop"), value: "NextVirtualDesktop" }
+    ])
+
+    function indexOfAction(model, value) {
+        for (let i = 0; i < model.length; ++i) {
+            if (model[i].value === value) {
+                return i;
+            }
+        }
+        return 0;
+    }
+
+    function isEnabled(action) {
+        return action !== "Disabled";
+    }
+
+    component DirectionIndicator: Rectangle {
+        id: indicator
+
+        property string iconName
+        property bool active: false
+
+        width: Kirigami.Units.gridUnit * 2.2
+        height: width
+        radius: width / 2
+        color: active ? Kirigami.Theme.highlightColor : Kirigami.Theme.backgroundColor
+        border.color: active ? Kirigami.Theme.highlightColor : Kirigami.Theme.disabledTextColor
+        border.width: 1
+        opacity: active ? 1 : 0.55
+
+        Kirigami.Icon {
+            anchors.centerIn: parent
+            width: Kirigami.Units.iconSizes.smallMedium
+            height: width
+            source: indicator.iconName
+            color: indicator.active ? Kirigami.Theme.highlightedTextColor : Kirigami.Theme.textColor
+        }
+    }
+
+    component TouchpadPreview: Item {
+        id: preview
+
+        property string upAction: "Disabled"
