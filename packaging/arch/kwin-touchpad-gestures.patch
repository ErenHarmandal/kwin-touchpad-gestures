+/*
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+
+#include "kcmkwintouchpadgestures.h"
+
+#include <KConfigGroup>
+#include <KPluginFactory>
+#include <KSharedConfig>
+
+#include <QSet>
+
+namespace
+{
+constexpr double defaultAxisLockMinimumDelta = 30.0;
+constexpr double defaultAxisLockDominanceRatio = 1.6;
+
+const QString disabledAction()
+{
+    return QStringLiteral("Disabled");
+}
+
+const QString defaultThreeFingerUp()
+{
+    return QStringLiteral("Overview");
+}
+
+const QString defaultThreeFingerDown()
+{
+    return QStringLiteral("MinimizeAll");
+}
+
+const QString defaultThreeFingerLeft()
+{
+    return QStringLiteral("SwitchWindowPrevious");
+}
+
+const QString defaultThreeFingerRight()
+{
+    return QStringLiteral("SwitchWindowNext");
+}
+
+const QString defaultFourFingerLeft()
+{
+    return QStringLiteral("PreviousVirtualDesktop");
+}
+
+const QString defaultFourFingerRight()
+{
+    return QStringLiteral("NextVirtualDesktop");
+}
+
+QString checkedAction(const KConfigGroup &group, const QString &key, const QString &defaultValue, const QSet<QString> &allowedActions)
+{
+    const QString action = group.readEntry(key, defaultValue);
+    if (allowedActions.contains(action)) {
+        return action;
+    }
+    return defaultValue;
+}
+
+bool sameDouble(double lhs, double rhs)
+{
+    return qFuzzyCompare(lhs + 1.0, rhs + 1.0);
+}
+}
+
+K_PLUGIN_FACTORY_WITH_JSON(KcmKWinTouchpadGesturesFactory, "kcm_kwintouchpadgestures.json", registerPlugin<KcmKWinTouchpadGestures>();)
+
+KcmKWinTouchpadGestures::KcmKWinTouchpadGestures(QObject *parent, const KPluginMetaData &metaData)
+    : KQuickConfigModule(parent, metaData)
+{
+    setButtons(Apply | Default);
+}
+
+KcmKWinTouchpadGestures::~KcmKWinTouchpadGestures() = default;
+
+QString KcmKWinTouchpadGestures::threeFingerUp() const
+{
+    return m_threeFingerUp;
+}
+
+void KcmKWinTouchpadGestures::setThreeFingerUp(const QString &action)
+{
+    if (m_threeFingerUp == action) {
+        return;
+    }
+    m_threeFingerUp = action;
+    Q_EMIT threeFingerUpChanged();
+    updateState();
+}
+
+QString KcmKWinTouchpadGestures::threeFingerDown() const
+{
+    return m_threeFingerDown;
+}
+
+void KcmKWinTouchpadGestures::setThreeFingerDown(const QString &action)
+{
+    if (m_threeFingerDown == action) {
+        return;
+    }
+    m_threeFingerDown = action;
+    Q_EMIT threeFingerDownChanged();
+    updateState();
+}
+
+QString KcmKWinTouchpadGestures::threeFingerLeft() const
+{
+    return m_threeFingerLeft;
+}
+
+void KcmKWinTouchpadGestures::setThreeFingerLeft(const QString &action)
+{
+    if (m_threeFingerLeft == action) {
+        return;
+    }
+    m_threeFingerLeft = action;
+    Q_EMIT threeFingerLeftChanged();
+    updateState();
+}
+
+QString KcmKWinTouchpadGestures::threeFingerRight() const
+{
+    return m_threeFingerRight;
+}
+
+void KcmKWinTouchpadGestures::setThreeFingerRight(const QString &action)
+{
+    if (m_threeFingerRight == action) {
+        return;
+    }
+    m_threeFingerRight = action;
+    Q_EMIT threeFingerRightChanged();
+    updateState();
+}
+
+QString KcmKWinTouchpadGestures::fourFingerLeft() const
+{
+    return m_fourFingerLeft;
+}
+
+void KcmKWinTouchpadGestures::setFourFingerLeft(const QString &action)
+{
+    if (m_fourFingerLeft == action) {
+        return;
+    }
+    m_fourFingerLeft = action;
+    Q_EMIT fourFingerLeftChanged();
+    updateState();
+}
+
+QString KcmKWinTouchpadGestures::fourFingerRight() const
+{
+    return m_fourFingerRight;
+}
+
+void KcmKWinTouchpadGestures::setFourFingerRight(const QString &action)
+{
+    if (m_fourFingerRight == action) {
+        return;
+    }
+    m_fourFingerRight = action;
+    Q_EMIT fourFingerRightChanged();
+    updateState();
+}
+
+double KcmKWinTouchpadGestures::axisLockMinimumDelta() const
+{
+    return m_axisLockMinimumDelta;
+}
+
+void KcmKWinTouchpadGestures::setAxisLockMinimumDelta(double delta)
+{
+    if (sameDouble(m_axisLockMinimumDelta, delta)) {
+        return;
+    }
+    m_axisLockMinimumDelta = delta;
+    Q_EMIT axisLockMinimumDeltaChanged();
+    updateState();
+}
+
+double KcmKWinTouchpadGestures::axisLockDominanceRatio() const
+{
+    return m_axisLockDominanceRatio;
+}
+
+void KcmKWinTouchpadGestures::setAxisLockDominanceRatio(double ratio)
+{
+    if (sameDouble(m_axisLockDominanceRatio, ratio)) {
+        return;
+    }
+    m_axisLockDominanceRatio = ratio;
+    Q_EMIT axisLockDominanceRatioChanged();
+    updateState();
+}
+
+void KcmKWinTouchpadGestures::load()
+{
+    const KConfigGroup group(KSharedConfig::openConfig(QStringLiteral("kwinrc")), QStringLiteral("TouchpadGestures"));
+    const QSet<QString> overviewActions = {disabledAction(), defaultThreeFingerUp()};
+    const QSet<QString> minimizeActions = {disabledAction(), defaultThreeFingerDown()};
+    const QSet<QString> horizontalActions = {
+        disabledAction(),
+        defaultThreeFingerLeft(),
+        defaultThreeFingerRight(),
+        defaultFourFingerLeft(),
+        defaultFourFingerRight(),
+    };
+
+    setThreeFingerUp(checkedAction(group, QStringLiteral("ThreeFingerUp"), defaultThreeFingerUp(), overviewActions));
+    setThreeFingerDown(checkedAction(group, QStringLiteral("ThreeFingerDown"), defaultThreeFingerDown(), minimizeActions));
+    setThreeFingerLeft(checkedAction(group, QStringLiteral("ThreeFingerLeft"), defaultThreeFingerLeft(), horizontalActions));
+    setThreeFingerRight(checkedAction(group, QStringLiteral("ThreeFingerRight"), defaultThreeFingerRight(), horizontalActions));
+    setFourFingerLeft(checkedAction(group, QStringLiteral("FourFingerLeft"), defaultFourFingerLeft(), horizontalActions));
+    setFourFingerRight(checkedAction(group, QStringLiteral("FourFingerRight"), defaultFourFingerRight(), horizontalActions));
+    setAxisLockMinimumDelta(group.readEntry("AxisLockMinimumDelta", defaultAxisLockMinimumDelta));
+    setAxisLockDominanceRatio(group.readEntry("AxisLockDominanceRatio", defaultAxisLockDominanceRatio));
+
+    m_savedThreeFingerUp = m_threeFingerUp;
+    m_savedThreeFingerDown = m_threeFingerDown;
+    m_savedThreeFingerLeft = m_threeFingerLeft;
+    m_savedThreeFingerRight = m_threeFingerRight;
+    m_savedFourFingerLeft = m_fourFingerLeft;
+    m_savedFourFingerRight = m_fourFingerRight;
+    m_savedAxisLockMinimumDelta = m_axisLockMinimumDelta;
+    m_savedAxisLockDominanceRatio = m_axisLockDominanceRatio;
+
+    updateState();
+}
+
+void KcmKWinTouchpadGestures::save()
+{
+    KSharedConfigPtr config = KSharedConfig::openConfig(QStringLiteral("kwinrc"));
+    KConfigGroup group(config, QStringLiteral("TouchpadGestures"));
+    group.writeEntry("ThreeFingerUp", m_threeFingerUp);
+    group.writeEntry("ThreeFingerDown", m_threeFingerDown);
+    group.writeEntry("ThreeFingerLeft", m_threeFingerLeft);
+    group.writeEntry("ThreeFingerRight", m_threeFingerRight);
+    group.writeEntry("FourFingerLeft", m_fourFingerLeft);
+    group.writeEntry("FourFingerRight", m_fourFingerRight);
+    group.writeEntry("AxisLockMinimumDelta", m_axisLockMinimumDelta);
+    group.writeEntry("AxisLockDominanceRatio", m_axisLockDominanceRatio);
+    group.sync();
+    config->sync();
+
+    m_savedThreeFingerUp = m_threeFingerUp;
+    m_savedThreeFingerDown = m_threeFingerDown;
+    m_savedThreeFingerLeft = m_threeFingerLeft;
+    m_savedThreeFingerRight = m_threeFingerRight;
+    m_savedFourFingerLeft = m_fourFingerLeft;
+    m_savedFourFingerRight = m_fourFingerRight;
+    m_savedAxisLockMinimumDelta = m_axisLockMinimumDelta;
+    m_savedAxisLockDominanceRatio = m_axisLockDominanceRatio;
+
+    updateState();
+}
+
+void KcmKWinTouchpadGestures::defaults()
+{
+    setThreeFingerUp(defaultThreeFingerUp());
+    setThreeFingerDown(defaultThreeFingerDown());
+    setThreeFingerLeft(defaultThreeFingerLeft());
+    setThreeFingerRight(defaultThreeFingerRight());
+    setFourFingerLeft(defaultFourFingerLeft());
+    setFourFingerRight(defaultFourFingerRight());
+    setAxisLockMinimumDelta(defaultAxisLockMinimumDelta);
+    setAxisLockDominanceRatio(defaultAxisLockDominanceRatio);
+    updateState();
+}
+
+void KcmKWinTouchpadGestures::updateState()
+{
+    setNeedsSave(isSaveNeeded());
+    setRepresentsDefaults(isDefaults());
+}
+
+bool KcmKWinTouchpadGestures::isDefaults() const
+{
+    return m_threeFingerUp == defaultThreeFingerUp()
+        && m_threeFingerDown == defaultThreeFingerDown()
+        && m_threeFingerLeft == defaultThreeFingerLeft()
+        && m_threeFingerRight == defaultThreeFingerRight()
+        && m_fourFingerLeft == defaultFourFingerLeft()
+        && m_fourFingerRight == defaultFourFingerRight()
+        && sameDouble(m_axisLockMinimumDelta, defaultAxisLockMinimumDelta)
+        && sameDouble(m_axisLockDominanceRatio, defaultAxisLockDominanceRatio);
+}
+
+bool KcmKWinTouchpadGestures::isSaveNeeded() const
+{
+    return m_threeFingerUp != m_savedThreeFingerUp
+        || m_threeFingerDown != m_savedThreeFingerDown
+        || m_threeFingerLeft != m_savedThreeFingerLeft
+        || m_threeFingerRight != m_savedThreeFingerRight
+        || m_fourFingerLeft != m_savedFourFingerLeft
+        || m_fourFingerRight != m_savedFourFingerRight
+        || !sameDouble(m_axisLockMinimumDelta, m_savedAxisLockMinimumDelta)
+        || !sameDouble(m_axisLockDominanceRatio, m_savedAxisLockDominanceRatio);
+}
+
+#include "kcmkwintouchpadgestures.moc"
+
+#include "moc_kcmkwintouchpadgestures.cpp"
