+*/
+
+#pragma once
+
+#include <KQuickConfigModule>
+
+#include <QString>
+
+class KcmKWinTouchpadGestures : public KQuickConfigModule
+{
+    Q_OBJECT
+    Q_PROPERTY(QString threeFingerUp READ threeFingerUp WRITE setThreeFingerUp NOTIFY threeFingerUpChanged)
+    Q_PROPERTY(QString threeFingerDown READ threeFingerDown WRITE setThreeFingerDown NOTIFY threeFingerDownChanged)
+    Q_PROPERTY(QString threeFingerLeft READ threeFingerLeft WRITE setThreeFingerLeft NOTIFY threeFingerLeftChanged)
+    Q_PROPERTY(QString threeFingerRight READ threeFingerRight WRITE setThreeFingerRight NOTIFY threeFingerRightChanged)
+    Q_PROPERTY(QString fourFingerLeft READ fourFingerLeft WRITE setFourFingerLeft NOTIFY fourFingerLeftChanged)
+    Q_PROPERTY(QString fourFingerRight READ fourFingerRight WRITE setFourFingerRight NOTIFY fourFingerRightChanged)
+    Q_PROPERTY(double axisLockMinimumDelta READ axisLockMinimumDelta WRITE setAxisLockMinimumDelta NOTIFY axisLockMinimumDeltaChanged)
+    Q_PROPERTY(double axisLockDominanceRatio READ axisLockDominanceRatio WRITE setAxisLockDominanceRatio NOTIFY axisLockDominanceRatioChanged)
+
+public:
+    explicit KcmKWinTouchpadGestures(QObject *parent, const KPluginMetaData &metaData);
+    ~KcmKWinTouchpadGestures() override;
+
+    QString threeFingerUp() const;
+    void setThreeFingerUp(const QString &action);
+
+    QString threeFingerDown() const;
+    void setThreeFingerDown(const QString &action);
+
+    QString threeFingerLeft() const;
+    void setThreeFingerLeft(const QString &action);
+
+    QString threeFingerRight() const;
+    void setThreeFingerRight(const QString &action);
+
+    QString fourFingerLeft() const;
+    void setFourFingerLeft(const QString &action);
+
+    QString fourFingerRight() const;
+    void setFourFingerRight(const QString &action);
+
+    double axisLockMinimumDelta() const;
+    void setAxisLockMinimumDelta(double delta);
+
+    double axisLockDominanceRatio() const;
+    void setAxisLockDominanceRatio(double ratio);
+
+public Q_SLOTS:
+    void load() override;
+    void save() override;
+    void defaults() override;
+
+Q_SIGNALS:
+    void threeFingerUpChanged();
+    void threeFingerDownChanged();
+    void threeFingerLeftChanged();
+    void threeFingerRightChanged();
+    void fourFingerLeftChanged();
+    void fourFingerRightChanged();
+    void axisLockMinimumDeltaChanged();
+    void axisLockDominanceRatioChanged();
+
+private:
+    void updateState();
+    bool isDefaults() const;
+    bool isSaveNeeded() const;
+
+    QString m_threeFingerUp;
+    QString m_threeFingerDown;
+    QString m_threeFingerLeft;
+    QString m_threeFingerRight;
+    QString m_fourFingerLeft;
+    QString m_fourFingerRight;
+    double m_axisLockMinimumDelta = 30.0;
+    double m_axisLockDominanceRatio = 1.6;
+
+    QString m_savedThreeFingerUp;
+    QString m_savedThreeFingerDown;
+    QString m_savedThreeFingerLeft;
+    QString m_savedThreeFingerRight;
+    QString m_savedFourFingerLeft;
+    QString m_savedFourFingerRight;
+    double m_savedAxisLockMinimumDelta = 30.0;
+    double m_savedAxisLockDominanceRatio = 1.6;
+};
