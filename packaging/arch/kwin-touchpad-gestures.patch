+
+bool Workspace::isTouchpadWindowSwitchCandidate(Window *window) const
+{
+    return window && !window->isDeleted() && window->isClient() && window->isShown() && window->wantsTabFocus()
+        && window->isOnCurrentDesktop() && window->isOnCurrentActivity() && !window->isMinimized()
+        && !window->isSpecialWindow() && !window->keepAbove() && !window->keepBelow();
+}
+
+void Workspace::rebuildTouchpadWindowSwitchChain()
+{
+    m_touchpadWindowSwitchChain.clear();
+    m_touchpadWindowSwitchIndex = -1;
+
+    Window *start = isTouchpadWindowSwitchCandidate(m_activeWindow) ? m_activeWindow : focusChain()->firstMostRecentlyUsed();
+    if (!start) {
+        return;
+    }
+
+    Window *window = start;
+    do {
+        if (isTouchpadWindowSwitchCandidate(window) && !m_touchpadWindowSwitchChain.contains(window)) {
+            m_touchpadWindowSwitchChain.append(window);
+            if (window == m_activeWindow) {
+                m_touchpadWindowSwitchIndex = m_touchpadWindowSwitchChain.size() - 1;
+            }
+        }
+        window = focusChain()->nextMostRecentlyUsed(window);
+    } while (window && window != start && !m_touchpadWindowSwitchChain.contains(window));
+
+    if (m_touchpadWindowSwitchIndex == -1 && !m_touchpadWindowSwitchChain.isEmpty()) {
+        m_touchpadWindowSwitchIndex = 0;
+    }
+}
+
+void Workspace::touchpadSwitchWindow(bool forward)
+{
+    if (!m_touchpadWindowSwitchTimer.isValid() || m_touchpadWindowSwitchTimer.elapsed() > 1200) {
+        rebuildTouchpadWindowSwitchChain();
+    } else {
+        for (auto it = m_touchpadWindowSwitchChain.begin(); it != m_touchpadWindowSwitchChain.end();) {
+            if (it->isNull() || !isTouchpadWindowSwitchCandidate(*it)) {
+                it = m_touchpadWindowSwitchChain.erase(it);
+            } else {
+                ++it;
+            }
+        }
+    }
+
+    if (m_touchpadWindowSwitchChain.size() < 2) {
+        m_touchpadWindowSwitchTimer.invalidate();
+        return;
+    }
+
+    if (m_touchpadWindowSwitchIndex < 0 || m_touchpadWindowSwitchIndex >= m_touchpadWindowSwitchChain.size()) {
+        m_touchpadWindowSwitchIndex = 0;
+    }
+
+    const int step = forward ? 1 : -1;
+    m_touchpadWindowSwitchIndex = (m_touchpadWindowSwitchIndex + step + m_touchpadWindowSwitchChain.size()) % m_touchpadWindowSwitchChain.size();
+    Window *window = m_touchpadWindowSwitchChain.at(m_touchpadWindowSwitchIndex);
+    if (window) {
+        activateWindow(window);
+        m_touchpadWindowSwitchTimer.restart();
+    }
+}
